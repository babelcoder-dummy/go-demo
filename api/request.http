POST {{$dotenv API_URL}}/auth/register
Content-Type: application/json

{
    "name": "user01",
    "email": "user01@babelcoder.com",
    "password": "user01password"
}

###
POST {{$dotenv API_URL}}/auth/login
Content-Type: application/json

{
    "email": "user01@babelcoder.com",
    "password": "user01password"
}

###
GET {{$dotenv API_URL}}/auth/me
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}

###
POST {{$dotenv API_URL}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{$dotenv REFRESH_TOKEN}}"
}

###
DELETE {{$dotenv API_URL}}/auth/logout
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}